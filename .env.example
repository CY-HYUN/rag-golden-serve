# The variables the service reads, with their defaults. compose.yaml and the chart set them; nothing loads this file.
# LLM_BASE_URL=http://localhost:8001/v1    # any OpenAI-compatible server
# LLM_MODEL=qwen2.5-0.5b-instruct
# LLM_API_KEY=                             # sent as a Bearer token when set
# LLM_TIMEOUT_S=120
# PROMPT_VERSION=v1                        # v1 or v2
# OTEL_EXPORTER_OTLP_ENDPOINT=             # for example http://localhost:4318; tracing is off when empty
# RGE_ROOT=                                # default: the vendor/rag-golden-eval submodule
#
# .env (ignored by git) is read only by Docker Compose, for the Langfuse overlay (compose.langfuse.yaml).
# It is written by: bash scripts/langfuse_env.sh
# LANGFUSE_BASE_URL=
# LANGFUSE_AUTH_B64=                       # both keys in base64: a secret
